<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>MeshTerminal.Host</AssemblyName>
    <Product>MeshTerminal</Product>
    <Title>MeshTerminal</Title>
    <RootNamespace>MeshTerminal.Host</RootNamespace>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../MeshTerminal/HostQrBridge.cs" Link="HostQrBridge.cs" />
    <Compile Include="../MeshTerminal/TerminalPalette.cs" Link="TerminalPalette.cs" />
    <Compile Include="../MeshTerminal/MapSymbolCatalog.cs" Link="MapSymbolCatalog.cs" />
    <Compile Remove="tools\GenerateDefaultAlertSound.cs" />
    <None Update="LICENSE-ZXing.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\meshtastic-alert.wav" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets\meshtastic-chirp.ico" />
    <EmbeddedResource Include="assets\icons\*.ico" />
    <None Update="assets\icons\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="RemoveReleasePdbFiles" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleasePdbFiles Include="$(TargetDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleasePdbFiles)" />
  </Target>
</Project>
